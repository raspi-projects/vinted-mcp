{
  "name": "@raspi-projects/vinted-mcp",
  "version": "0.3.0",
  "private": true,
  "description": "MCP server for Vinted: search, deal finding, listing photos as images, and seller trust reports.",
  "main": "dist/bundle.js",
  "bin": {
    "vinted-mcp": "dist/bundle.js",
    "vinted-mcp-server": "dist/bundle.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "bundle": "esbuild src/bin/cli.ts --bundle --platform=node --target=node22 --outfile=dist/bundle.js --format=cjs --external:@modelcontextprotocol/sdk --external:playwright --external:playwright-core --external:playwright-extra --external:puppeteer-extra-plugin-stealth",
    "clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true }); require('fs').rmSync('dist-ts', { recursive: true, force: true });\"",
    "start": "node dist/bundle.js",
    "test": "node --test tests/*.test.cjs",
    "update-categories": "npm run build && node scripts/update-categories.cjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.12",
    "typescript": "^5.9.3"
  },
  "keywords": [
    "vinted",
    "mcp",
    "model-context-protocol",
    "claude",
    "cursor",
    "ai",
    "scraper",
    "marketplace",
    "fashion",
    "price-comparison",
    "second-hand",
    "mcp-server",
    "ai-tools",
    "shopping-assistant"
  ],
  "license": "AGPL-3.0-or-later",
  "author": "andrijdavid (upstream), raspi-projects (fork)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/raspi-projects/vinted-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/raspi-projects/vinted-mcp/issues"
  },
  "homepage": "https://github.com/raspi-projects/vinted-mcp#readme",
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist/bundle.js",
    "README.md",
    "LICENSE.md",
    ".env.example"
  ]
}
